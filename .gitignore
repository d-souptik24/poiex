# ==============================================================================
# PoiEx — Comprehensive .gitignore
# ==============================================================================

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Environment Variables & Secrets ---
# Block all environment files except sanitized template
.env*
*.env
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Sensitive certificates, tokens, and private keys
*.pem
*.key
*.crt
*.pfx
*.cer
*.p12
id_rsa*
id_ecdsa*
id_ed25519*
*.token
auth-token*
.npmrc
.yarnrc

# Cloud credentials and service account files
client_secret*.json
*service-account*.json
*serviceAccount*.json
*credentials*.json
!components.json

# --- Next.js, Turbopack & Build Outputs ---
/.next/
/out/
/.turbo/
/build
/dist
/coverage
/.cache/
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Operating Systems & File Managers ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
[Dd]esktop.ini
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk

# Linux / Generic Temp
*~
*.bak
*.tmp
*.temp
tmp/
temp/
scratch/

# --- Debug & Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.history/

# --- Editors & IDEs ---
.vscode/
.idea/
.cursor/
.fleet/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.*.swp
.*.swo

# --- AI Agents, Tooling & Planning ---
AGENTS.md
CLAUDE.md
/.agents/
/.claude/
/.windsurf/
/.gemini/
/.continue/
/.aider*
/docs/
/walkthrough/
/plan/
/graphify-out/
skills-lock.json

# --- Database, Storage & Runtime Artifacts ---
/lib/generated/prisma
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
*.dump

