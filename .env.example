# Environment variables for PoiEx
# Copy this file to .env and fill in your local values

# Database Connection (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/poiex?retryWrites=true&w=majority"

# Auth.js / NextAuth v5
AUTH_SECRET="your-auth-secret-here"

# OAuth Providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Local Ollama AI Code Autocompletion
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:1.5b-base"

# Cloud AI Fallback Providers
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Optional: Dedicated Autocomplete API Keys (isolated rate-limit quotas for inline ghost text)
# If omitted, autocomplete seamlessly falls back to GEMINI_API_KEY and GROQ_API_KEY.
GEMINI_AUTOCOMPLETE_KEY=""
GROQ_AUTOCOMPLETE_KEY=""


